# Bell3 backend API base URL — must end with /api/ (trailing slash required)
NEXT_PUBLIC_BELL3_API_URL=https://your-ngrok-url.ngrok-free.dev/api/

# Creator web app origin — used for referral invite links (/register?ref=…)
NEXT_PUBLIC_BELL3_WEB_APP_URL=https://app.bell3.net

# Set to "false" when backend finance endpoints are live (packages use wallet/packages API)
NEXT_PUBLIC_USE_FINANCE_MOCK=true
